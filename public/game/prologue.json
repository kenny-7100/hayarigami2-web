:22,"text":"是想让你去监视某个人。"},{"offset":57154,"length":8,"op":202,"args":[0,0]},{"offset":57162,"length":12,"text":"要秘密进行」"},{"offset":57174,"length":6,"op":204,"args":[769]},{"offset":57192,"length":4,"op":4,"args":[]},{"offset":57196,"length":10,"op":3,"args":[0,230,2]},{"offset":57208,"length":40,"text":"被叫出来，然后又突然被命令去监视某个人。"},{"offset":57248,"length":6,"op":204,"args":[1]},{"offset":57256,"length":40,"text":"日本的宪法里应该有写『尊重个人权利』吧，"},{"offset":57296,"length":6,"op":204,"args":[0]},{"offset":57304,"length":16,"text":"难道是我听错了？"},{"offset":57356,"length":6,"op":204,"args":[769]},{"offset":57364,"length":4,"op":4,"args":[]},{"offset":57368,"length":10,"op":3,"args":[0,230,3]},{"offset":57380,"length":10,"text":"「那个……"},{"offset":57396,"length":8,"op":202,"args":[0,0]},{"offset":57404,"length":28,"text":"可是，每个人都有隐私权……」"},{"offset":57432,"length":6,"op":204,"args":[1]},{"offset":57440,"length":4,"text":"虽然"},{"offset":57468,"length":32,"text":"知道答案会是什么，但为了更确定，"},{"offset":57500,"length":6,"op":204,"args":[0]},{"offset":57508,"length":22,"text":"我还是试着反驳了一下。"},{"offset":57532,"length":6,"op":204,"args":[769]},{"offset":57540,"length":4,"op":4,"args":[]},{"offset":57544,"length":10,"op":3,"args":[0,230,4]},{"offset":57556,"length":20,"text":"「只要不被对方发现，"},{"offset":57576,"length":6,"op":204,"args":[0]},{"offset":57584,"length":10,"text":"就不会构成"},{"offset":57596,"length":18,"text":"侵犯个人隐私了吧？"},{"offset":57614,"length":6,"op":204,"args":[1]},{"offset":57622,"length":20,"text":"反正都是家常便饭了」"},{"offset":57642,"length":6,"op":204,"args":[769]},{"offset":57672,"length":4,"op":4,"args":[]},{"offset":57676,"length":10,"op":3,"args":[0,230,5]},{"offset":57688,"length":10,"text":"就是这样。"},{"offset":57698,"length":8,"op":202,"args":[0,0]},{"offset":57706,"length":26,"text":"一旦尝到点拥有权力的甜头，"},{"offset":57732,"length":6,"op":204,"args":[0]},{"offset":57740,"length":24,"text":"人类就会变得越来越傲慢，"},{"offset":57764,"length":6,"op":204,"args":[0]},{"offset":57772,"length":24,"text":"终有一天把自己当成了神。"},{"offset":57796,"length":6,"op":204,"args":[769]},{"offset":57804,"length":4,"op":4,"args":[]},{"offset":57808,"length":10,"op":3,"args":[0,230,6]},{"offset":57820,"length":34,"text":"我面前的诸神，就是以他们坚信的所谓"},{"offset":57854,"length":6,"op":204,"args":[0]},{"offset":57864,"length":34,"text":"正义之名，在阴暗的禁区里秘密结社，"},{"offset":57898,"length":6,"op":204,"args":[0]},{"offset":57906,"length":4,"text":"乐此"},{"offset":57912,"length":22,"text":"不疲地从事着暗中活动。"},{"offset":57936,"length":6,"op":204,"args":[769]},{"offset":57944,"length":4,"op":4,"args":[]},{"offset":57948,"length":10,"op":3,"args":[0,230,7]},{"offset":57960,"length":18,"text":"世人会有所察觉吗？"},{"offset":58000,"length":6,"op":204,"args":[769]},{"offset":58008,"length":4,"op":4,"args":[]},{"offset":58012,"length":10,"op":3,"args":[0,230,8]},{"offset":58024,"length":34,"text":"就连个人隐私这种宪法赋予的基本人权"},{"offset":58058,"length":6,"op":204,"args":[0]},{"offset":58066,"length":24,"text":"都在不断地受着侵犯……。"},{"offset":58090,"length":6,"op":204,"args":[769]},{"offset":58116,"length":4,"op":4,"args":[]},{"offset":58120,"length":10,"op":3,"args":[0,230,9]},{"offset":58132,"length":32,"text":"这可不仅仅是跟踪、窃听、狗仔队、"},{"offset":58176,"length":6,"op":204,"args":[0]},{"offset":58184,"length":16,"text":"这种程度的问题。"},{"offset":58200,"length":6,"op":204,"args":[769]},{"offset":58220,"length":4,"op":4,"args":[]},{"offset":58224,"length":10,"op":3,"args":[0,230,10]},{"offset":58236,"length":24,"text":"越了解真相，就越觉得ＮＳ"},{"offset":58260,"length":14,"op":2013,"args":[2,29190,29290,29290,106]},{"offset":58276,"length":12,"text":"Ａ和梯队系统"},{"offset":58288,"length":18,"op":2013,"args":[3,29194,29290,29290,29290,29290,106]},{"offset":58308,"length":2,"text":"之"},{"offset":58312,"length":4,"text":"类的"},{"offset":58316,"length":6,"op":204,"args":[0]},{"offset":58324,"length":20,"text":"不过是小巫见大巫了。"},{"offset":58344,"length":6,"op":204,"args":[769]},{"offset":58352,"length":4,"op":4,"args":[]},{"offset":58356,"length":10,"op":3,"args":[0,230,11]},{"offset":58368,"length":38,"text":"近几年，美国建立了通过ＧＰＳ卫星定位，"},{"offset":58406,"length":6,"op":204,"args":[0]},{"offset":58414,"length":32,"text":"对有犯罪前科的人进行监视的系统。"},{"offset":58448,"length":24,"op":2013,"args":[4,29200,29290,29290,29290,29290,29290,29290,29290,106]},{"offset":58472,"length":6,"op":204,"args":[0]},{"offset":58480,"length":34,"text":"不过，那个真的只被用在罪犯身上吗？"},{"offset":58514,"length":6,"op":204,"args":[769]},{"offset":58576,"length":4,"op":4,"args":[]},{"offset":58580,"length":10,"op":3,"args":[0,230,12]},{"offset":58592,"length":22,"text":"人们差不多也该察觉到，"},{"offset":58624,"length":6,"op":204,"args":[1]},{"offset":58632,"length":24,"text":"自己也有被监视的可能吧。"},{"offset":58656,"length":6,"op":204,"args":[769]},{"offset":58680,"length":4,"op":4,"args":[]},{"offset":58684,"length":10,"op":3,"args":[0,230,13]},{"offset":58696,"length":30,"text":"「那么，这次又打算监视谁呢？」"},{"offset":58732,"length":6,"op":204,"args":[769]},{"offset":58740,"length":4,"op":4,"args":[]},{"offset":58744,"length":10,"op":3,"args":[0,230,14]},{"offset":58756,"length":32,"text":"我跟诸神说话时的口气带着点轻蔑，"},{"offset":58788,"length":6,"op":204,"args":[0]},{"offset":58796,"length":38,"text":"无论如何，我也不想对这群家伙表示敬意。"},{"offset":58852,"length":6,"op":204,"args":[769]},{"offset":58860,"length":4,"op":4,"args":[]},{"offset":58864,"length":6,"op":402,"args":[2]},{"offset":58872,"length":12,"op":403,"args":[0,0,0,2]},{"offset":58884,"length":12,"op":403,"args":[32896,32896,120,2]},{"offset":58896,"length":6,"op":201,"args":[120]},{"offset":58904,"length":12,"op":403,"args":[0,0,120,0]},{"offset":58916,"length":12,"op":403,"args":[32896,128,0,1]},{"offset":58928,"length":10,"op":3,"args":[0,230,15]},{"offset":58940,"length":36,"text":"「这个人你也认识，都打过多次交道了。"},{"offset":58976,"length":6,"op":204,"args":[1]},{"offset":58984,"length":18,"text":"他的名字是———」"},{"offset":59032,"length":6,"op":204,"args":[769]},{"offset":59040,"length":4,"op":4,"args":[]},{"offset":59044,"length":8,"op":801,"args":[256,2490]},{"offset":59052,"length":12,"op":701,"args":[0,32768,120,0]},{"offset":59064,"length":8,"op":905,"args":[120,0]},{"offset":59072,"length":6,"op":201,"args":[120]},{"offset":59080,"length":8,"op":905,"args":[0,0]},{"offset":59088,"length":4,"op":906,"args":[]},{"offset":59092,"length":12,"op":902,"args":[8,0,0,0]},{"offset":59104,"length":57,"op":1001,"args":[0,261,1,1,22127,32369,38526,16495,48744,876,43368,42612,6769,36725,47742,45430,46700,22127,32369,38270,0,0,0,0,0,0]},{"offset":59164,"length":57,"op":1001,"args":[1,261,1,257,17257,25969,38526,16495,48744,876,43368,42612,6769,36725,47742,45430,46700,17257,25969,38270,0,0,0,0,0,0]},{"offset":59224,"length":12,"op":701,"args":[0,0,120,0]},{"offset":59236,"length":4,"op":903,"args":[]},{"offset":59240,"length":8,"op":904,"args":[8,1]},{"offset":59248,"length":8,"op":905,"args":[0,128]},{"offset":59256,"length":6,"op":201,"args":[120]},{"offset":59264,"length":6,"op":1309,"args":[0]},{"offset":59272,"length":8,"op":106,"args":[1,2490]},{"offset":59280,"length":8,"op":101,"args":[4,0]},{"offset":59288,"length":4,"op":107,"args":[]},{"offset":59292,"length":8,"op":106,"args":[256,2490]},{"offset":59300,"length":8,"op":101,"args":[3,0]},{"offset":59308,"length":4,"op":107,"args":[]},{"offset":59312,"length":4,"op":2,"args":[]}]},"3":{"id":3,"offset":59316,"size":3004,"instructions":[{"offset":59316,"length":12,"op":1,"args":[3,0,0,0]},{"offset":59328,"length":8,"op":401,"args":[196,2]},{"offset":59336,"length":8,"op":401,"args":[515,0]},{"offset":59344,"length":4,"op":1311,"args":[]},{"offset":59348,"length":6,"op":402,"args":[0]},{"offset":59356,"length":12,"op":403,"args":[0,0,0,0]},{"offset":59368,"length":6,"op":402,"args":[2]},{"offset":59376,"length":12,"op":403,"args":[32896,32896,0,2]},{"offset":59388,"length":6,"op":201,"args":[10]},{"offset":59396,"length":10,"op":3,"args":[0,230,0]},{"offset":59408,"length":2,"text":"「"},{"offset":59412,"length":6,"text":"原来是"},{"offset":59418,"length":6,"op":213,"args":[0]},{"offset":59426,"length":6,"op":213,"args":[1]},{"offset":59434,"length":4,"text":"……"},{"offset":59440,"length":4,"text":"啊。"},{"offset":59444,"length":6,"op":204,"args":[1]},{"offset":59452,"length":26,"text":"这个人还有监视的必要吗？」"},{"offset":59480,"length":6,"op":204,"args":[769]},{"offset":59488,"length":4,"op":4,"args":[]},{"offset":59492,"length":10,"op":3,"args":[0,230,1]},{"offset":59504,"length":36,"text":"「无论是私立花峰高中的『笔仙』事件，"},{"offset":59540,"length":28,"op":2013,"args":[108,29204,29290,29290,29290,29290,29290,29290,29290,29290,29290,106]},{"offset":59568,"length":6,"op":204,"args":[0]},{"offset":59576,"length":24,"text":"还是町田市的『鬼』事件，"},{"offset":59600,"length":6,"op":204,"args":[0]},{"offset":59608,"length":28,"text":"我对他的一举一动都很感兴趣」"},{"offset":59648,"length":6,"op":204,"args":[769]},{"offset":59656,"length":4,"op":4,"args":[]},{"offset":59660,"length":10,"op":3,"args":[0,230,2]},{"offset":59672,"length":32,"text":"「从今往后，只要是他负责的案子，"},{"offset":59708,"length":6,"op":204,"args":[0]},{"offset":59716,"length":24,"text":"我们都想给予特别的关注。"},{"offset":59760,"length":6,"op":204,"args":[1]},{"offset":59768,"length":26,"text":"视情况施以援手也是可以的」"},{"offset":59794,"length":6,"op":204,"args":[769]},{"offset":59812,"length":4,"op":4,"args":[]},{"offset":59816,"length":12,"op":403,"args":[32896,32896,120,0]},{"offset":59828,"length":12,"op":403,"args":[0,0,120,2]},{"offset":59840,"length":6,"op":201,"args":[120]},{"offset":59848,"length":12,"op":403,"args":[32896,128,0,2]},{"offset":59860,"length":10,"op":3,"args":[0,230,3]},{"offset":59872,"length":28,"text":"这些自以为是、傲慢虚伪的神，"},{"offset":59900,"length":6,"op":204,"args":[0]},{"offset":59908,"length":24,"text":"还是像往常一样令人作呕。"},{"offset":59960,"length":6,"op":204,"args":[769]},{"offset":59968,"length":4,"op":4,"args":[]},{"offset":59972,"length":10,"op":3,"args":[0,230,4]},{"offset":59984,"length":32,"text":"一想到他们才是掌握事实真相的人，"},{"offset":60016,"length":6,"op":204,"args":[0]},{"offset":60024,"length":20,"text":"就实在有些不寒而栗。"},{"offset":60048,"length":6,"op":204,"args":[769]},{"offset":60056,"length":4,"op":4,"arg