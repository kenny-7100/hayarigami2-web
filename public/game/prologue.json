op":3,"args":[0,230,11]},{"offset":60792,"length":10,"text":"「没问题。"},{"offset":60804,"length":8,"op":202,"args":[0,0]},{"offset":60812,"length":16,"text":"我只是突然想到，"},{"offset":60828,"length":6,"op":204,"args":[0]},{"offset":60836,"length":30,"text":"各位老师都有过初恋的经验吧？」"},{"offset":60884,"length":6,"op":204,"args":[769]},{"offset":60892,"length":4,"op":4,"args":[]},{"offset":60896,"length":10,"op":3,"args":[0,230,12]},{"offset":60908,"length":24,"text":"面对我这突如其来的提问，"},{"offset":60936,"length":6,"op":204,"args":[0]},{"offset":60944,"length":36,"text":"也许他们是不知所措，又或是置若罔闻，"},{"offset":60980,"length":6,"op":204,"args":[0]},{"offset":60988,"length":20,"text":"一时之间竟陷入冷场。"},{"offset":61016,"length":6,"op":204,"args":[769]},{"offset":61024,"length":4,"op":4,"args":[]},{"offset":61028,"length":10,"op":3,"args":[0,230,13]},{"offset":61040,"length":28,"text":"「只能埋藏在自己心底的初恋」"},{"offset":61080,"length":6,"op":204,"args":[769]},{"offset":61088,"length":4,"op":4,"args":[]},{"offset":61092,"length":10,"op":3,"args":[0,230,14]},{"offset":61104,"length":26,"text":"「如果连这都要被监视的话，"},{"offset":61130,"length":6,"op":204,"args":[0]},{"offset":61138,"length":20,"text":"会是怎样的心情呢？」"},{"offset":61176,"length":6,"op":204,"args":[769]},{"offset":61184,"length":4,"op":4,"args":[]},{"offset":61188,"length":10,"op":3,"args":[0,230,15]},{"offset":61200,"length":24,"text":"这不是我对诸神们的提问。"},{"offset":61232,"length":6,"op":204,"args":[0]},{"offset":61240,"length":28,"text":"而是对我与这群家伙终归是同类"},{"offset":61268,"length":6,"op":204,"args":[0]},{"offset":61276,"length":32,"text":"这一无法逃避的事实所发出的自嘲。"},{"offset":61308,"length":6,"op":204,"args":[769]},{"offset":61332,"length":4,"op":4,"args":[]},{"offset":61336,"length":10,"op":3,"args":[0,230,16]},{"offset":61348,"length":38,"text":"「这件事是从朋友的朋友那里听来的……」"},{"offset":61386,"length":6,"op":204,"args":[769]},{"offset":61404,"length":4,"op":4,"args":[]},{"offset":61408,"length":8,"op":905,"args":[240,0]},{"offset":61416,"length":12,"op":403,"args":[0,0,240,0]},{"offset":61428